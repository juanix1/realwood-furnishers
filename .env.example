# Copy to .env and fill in. Only the PUBLIC anon key belongs here.
# NEVER put the Supabase service-role key in any VITE_ variable —
# everything prefixed VITE_ is shipped to the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Business contact details (international format, digits only for WhatsApp)
VITE_WHATSAPP_NUMBER=254700000000
VITE_PHONE_NUMBER=+254700000000
VITE_CONTACT_EMAIL=
VITE_BUSINESS_HOURS=Mon - Sat: 8:00 AM - 6:00 PM
